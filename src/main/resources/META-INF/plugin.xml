<idea-plugin>
    <!-- ============ 插件元信息 ============ -->
    <id>com.codementor</id>
    <name>CodeMentor</name>
    <vendor url="https://github.com/CreateKIBO/code_learning_helper">Kibo</vendor>

    <!-- ============ 兼容的 IDE 范围 ============ -->
    <!-- 仅支持 IDEA 2024.1.x（241.*）。具体值由 Gradle 构建时注入，这里留空占位。 -->
    <!-- idea-version 标签由 IntelliJ Platform Gradle Plugin 2.x 自动生成，不要手填 sinceBuild/untilBuild。 -->

    <!-- ============ 描述 ============ -->
    <description><![CDATA[
        CodeMentor is an AI-assisted Java learning coach for IntelliJ IDEA.
        <h3>CodeMentor：IntelliJ IDEA 内的 Java 学习教练</h3>
        <p>住在 IntelliJ IDEA 里的 Java 学习教练。</p>
        <p>选中代码或把光标放在方法内：Alt+M 评审写法，Alt+Shift+M 解释代码。</p>
        <p>建议遵循“代码证据 → 思考提示 → 最小下一步 → 自测”的学习路径；支持按需讲解、追问，以及完整方法评审后的修改验证。</p>
        <p>支持 JavaWeb 分层识别、发送前隐私预览、本地学习统计，以及提示逐条揭示的薄弱知识点小练习。</p>
        <p>代码上下文只会在用户主动操作或明确开启保存触发后发送到用户配置的模型服务。</p>
        <p><a href="https://github.com/CreateKIBO/code_learning_helper/blob/main/PRIVACY.md">隐私说明</a> ·
        <a href="https://github.com/CreateKIBO/code_learning_helper/blob/main/docs/INSTALL.md">安装与数据清理</a></p>
    ]]></description>

    <!-- ============ 依赖的内置插件 ============ -->
    <!-- Java PSI 能力（PsiMethod / PsiClass）来自 com.intellij.java -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <!-- ============ 扩展点注册 ============ -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- 教练侧栏 Tool Window -->
        <toolWindow id="CodeMentor"
                    anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowProject"
                    factoryClass="com.codementor.ui.MentorToolWindowFactory"/>

        <!-- 设置页：IDE Settings → Tools → CodeMentor -->
        <applicationConfigurable parentId="tools"
                                 id="com.codementor.settings.CodeMentorConfigurable"
                                 displayName="CodeMentor"
                                 instance="com.codementor.settings.CodeMentorConfigurable"/>

        <!-- 跟踪最后真实编辑位置，供保存触发精确定位被修改的方法。 -->
        <editorFactoryListener implementation="com.codementor.action.LastEditTracker"/>
    </extensions>

    <!-- ============ 动作注册 ============ -->
    <actions>
        <action id="CodeMentor.ReviewCurrent"
                class="com.codementor.action.ReviewAction"
                text="请导师评审(_M)"
                description="评审选中的代码或当前方法">
            <!-- 快捷键 Alt+M（带下划线 Mnemonic） -->
            <keyboard-shortcut keymap="$default" first-keystroke="alt M"/>
            <!-- 右键编辑器菜单入口 -->
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="CodeMentor.ExplainCurrent"
                class="com.codementor.action.ExplainAction"
                text="请导师解释(_E)"
                description="解释选中的代码或当前方法">
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift M"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>

    <applicationListeners>
        <listener class="com.codementor.action.SaveReviewListener"
                  topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
    </applicationListeners>
</idea-plugin>
